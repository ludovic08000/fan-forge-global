{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://usjxcgauyvdocngfkhys.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "fan-forge-global",
      "version": "0.1.0",
      "title": "fan-forge-global"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Get the signed-in user's public profile on The Forge (display name, bio, avatar, verification status).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_creator_stats",
        "title": "Get my creator stats",
        "description": "Get the signed-in creator's key stats on The Forge: stage name, subscription price, subscriber count, published content count and total earnings.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_content",
        "title": "List my content",
        "description": "List the signed-in creator's content items on The Forge with title, type, price, status and engagement counters.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Maximum number of items to return (default 20, max 100)."
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "archived"
              ],
              "description": "Filter by publication status."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_subscriptions",
        "title": "List my subscriptions",
        "description": "List the subscriptions of the signed-in account on The Forge — the creators they subscribe to, plus subscriptions received when the account is a creator.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "expired",
                "canceled"
              ],
              "description": "Filter by subscription status."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of subscriptions to return (default 20, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_notifications",
        "title": "List my notifications",
        "description": "List the signed-in user's recent notifications on The Forge (new subscribers, tips, messages, sales).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "unread_only": {
              "type": "boolean",
              "description": "Only return unread notifications."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of notifications to return (default 20, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_live_streams",
        "title": "List my live streams",
        "description": "List the signed-in creator's live streams on The Forge (scheduled, live and ended) with viewer counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "scheduled",
                "live",
                "ended"
              ],
              "description": "Filter by stream status."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of streams to return (default 20, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
